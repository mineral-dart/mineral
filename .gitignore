.dart_tool/
.packages
.idea
*.iml
.DS_Store

# Conventional directory for build outputs.
build/

# pubspec.lock is committed at the workspace root (see pubspec.lock) so that
# CI and `dart pub publish` resolve a reviewable, reproducible dependency
# set. This does not affect consumers of this library — pub ignores a
# dependency's own lockfile — it only pins CI/publish-time resolution.
# https://dart.dev/guides/libraries/private-files#pubspeclock

# Directory created by dartdoc
doc/api
